# =============================================================================
# Nihongo Mock — environment variables
#
# Local setup:  copy this file to .env  (cp .env.example .env)  and fill in the blanks.
# .env is git-ignored. NEVER commit real keys, and never paste them into chats or tickets.
# Staging/production: enter these in your hosting provider's "Environment variables"
# or "Secrets" settings instead of a file.
# Full inventory, owners and rotation notes: docs/ENVIRONMENT_REQUIREMENTS.md
#
# SECRET = keep private. If one leaks, create a new one at the provider and replace it here.
# =============================================================================


# ---- Runtime -----------------------------------------------------------------

# Where this copy of the app runs: local | test | staging | production
# "production" switches on strict checks (real email through Resend, real sender address).
# NODE_ENV is set automatically by Next.js — do not add it here.
APP_ENV=local

# Public address of the site, without a trailing slash.
# Local: http://localhost:3000   Production: e.g. https://nihongomock.com
APP_URL=http://localhost:3000

# How much the server logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true ONLY when the app runs behind your own reverse proxy (staging/production).
# It lets rate limits see each visitor's real IP address (from X-Forwarded-For).
TRUST_PROXY=false


# ---- Database (PostgreSQL) -----------------------------------------------------

# SECRET in staging/production.
# Local: the Docker database started by `pnpm db:up` (these local credentials are not secret).
# Staging/production: the connection string from your database host's dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nihongo_mock

# Maximum database connections per running copy of the app.
DATABASE_POOL_MAX=10


# ---- Payload CMS -----------------------------------------------------------------

# SECRET. Signs everyone's login sessions. At least 32 characters.
# Changing it logs every student and admin out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=paste-a-64-character-random-hex-string-here


# ---- Email (Resend — https://resend.com) ----------------------------------------

# How emails (verification, password reset) are delivered:
#   console = printed in the terminal with their links; nothing is sent (local default)
#   resend  = really sent through Resend (required when APP_ENV=production)
#   memory  = kept in memory (automated tests only)
EMAIL_TRANSPORT=console

# SECRET. Resend API key, starts with "re_".
# Get it: resend.com → log in → API Keys → Create API Key
#         Permission: "Sending access"; Domain: your sending domain (or "All domains").
# Check it works (sends nothing):  pnpm email:check
RESEND_API_KEY=

# The "From" address. It must be on a domain you have verified in Resend (Resend → Domains).
# Before your domain is verified, Resend only allows onboarding@resend.dev, and only to
# the email address you signed up to Resend with.
EMAIL_FROM_ADDRESS=no-reply@nihongomock.invalid

# Name shown as the sender.
EMAIL_FROM_NAME=Nihongo Mock

# ---- WHEN YOU BUY YOUR DOMAIN (not needed until then) ----------------------------
# You don't have a domain yet, so leave the email lines above as they are: locally,
# emails are printed in the terminal (EMAIL_TRANSPORT=console) and nothing needs a domain.
#
# After buying a domain (example below: nihongomock.com — use yours):
#   1. Resend → Domains → Add Domain → enter nihongomock.com (or mail.nihongomock.com).
#   2. Copy the DNS records Resend shows (MX, SPF, DKIM) into your domain registrar's
#      DNS settings, then click "Verify DNS Records" in Resend and wait for "Verified".
#   3. Change these lines above:
#        EMAIL_FROM_ADDRESS=no-reply@nihongomock.com
#        EMAIL_TRANSPORT=resend          (only if you want real emails locally too)
#   4. Run:  pnpm email:check           (confirms the key and domain; sends nothing)
#
# On the live server later (set in the hosting provider's settings, not in a file):
#        APP_ENV=production
#        APP_URL=https://nihongomock.com
#        TRUST_PROXY=true
#        EMAIL_TRANSPORT=resend
#        EMAIL_FROM_ADDRESS=no-reply@nihongomock.com
#        RESEND_API_KEY=<a separate "Sending access" key restricted to that domain>
# ---------------------------------------------------------------------------------


# ---- Later phases (not used yet) ------------------------------------------------
# Leave these commented out until the phase that needs them; that phase will explain
# where to get each value. Names for payment providers are confirmed against their
# official documentation in Phases 20–23 and may change.
#
# Phase 12 — Cloudflare R2 (images, audio, PDFs)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PUBLIC=
# R2_BUCKET_PRIVATE=
# MEDIA_PUBLIC_BASE_URL=
#
# Phase 21–23 — payments (eSewa, Khalti, connectIPS)
# ESEWA_PRODUCT_CODE=
# ESEWA_SECRET_KEY=
# KHALTI_SECRET_KEY=
# CONNECTIPS_MERCHANT_ID=
# CONNECTIPS_APP_ID=
# CONNECTIPS_APP_NAME=
# CONNECTIPS_PASSWORD=
# CONNECTIPS_PRIVATE_KEY=
#
# Phase 26 — error monitoring (Sentry)
# SENTRY_DSN=
