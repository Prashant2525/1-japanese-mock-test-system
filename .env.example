# Copy to .env for local development. Never commit .env.
# Full inventory: docs/ENVIRONMENT_REQUIREMENTS.md

# Runtime (NODE_ENV is set by Next.js and the scripts; do not set it here)
# APP_ENV: local | test | staging | production (production enables strict checks, e.g. real email)
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database — local Docker defaults from docker/compose.dev.yml (local only, not a secret)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nihongo_mock
DATABASE_POOL_MAX=10

# Payload — server-only secret, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-64-character-random-hex-string

# Set to true only when running behind your own reverse proxy (enables per-IP rate limits)
TRUST_PROXY=false

# Email: console (development; prints links), resend (staging/production), memory (tests)
EMAIL_TRANSPORT=console
# RESEND_API_KEY=            # server-only secret from the Resend dashboard; never commit it
EMAIL_FROM_ADDRESS=no-reply@nihongomock.invalid
EMAIL_FROM_NAME=Nihongo Mock
